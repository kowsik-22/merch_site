# Get these from Razorpay Dashboard → Settings → API Keys
# https://dashboard.razorpay.com/app/keys
#
# Use TEST mode keys (prefixed rzp_test_) while developing.
# Switch to LIVE mode keys (rzp_live_) only once you're ready to accept real payments.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here

# Set this up in Razorpay Dashboard → Settings → Webhooks — see README.md
# "Webhook setup" section for the full walkthrough, including local testing.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Google Sheets order logging — see README.md "Google Sheets setup" section
# for how to create these from a Google Cloud service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the_long_id_from_your_sheet_url
